# Copy these into the host's environment settings (Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# The address this site is served from (a full https:// URL). Without it each site falls back to its own
# built-in address: the classes site then tells search engines NOT to index it; the wedding site uses toolieka.com.
NEXT_PUBLIC_SITE_URL=https://example.com

# The key ContentSathi shows ONCE when you connect this site (SEO Harness → connect a website).
# Several keys may be listed, comma-separated, so a key can be rotated without a gap.
CONTENTSATHI_WEBHOOK_KEY=

# Where received posts are committed (a fine-grained token limited to this repository, Contents: Read and write).
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=owner/name
GITHUB_CONTENT_BRANCH=main

# Optional: force the store ("github" or "fs"). Unset is right for almost everyone.
# CONTENT_STORE=

# ── Admin panel (Supabase) ── see ADMIN.md
# Supabase → Project Settings → API. The anon key is safe in the browser: the database rules
# decide what it can do. NEVER put the service_role key in the website's settings.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
